0,null],"CO-4":[0,0,0,null],"FL-13":[151443,154351,98,"L"],"FL-2":[146862,160746,99,"L"],"FL-7":[158132,160079,99,null],"GA-2":[108923,77229,70,"W"],"KS-2":[79321,71545,60,null],"KY-6":[116672,89347,92,"W"],"MN-1":[430,1314,1,null],"MT-1":[0,0,0,null],"NC-11":[190998,140121,92,"W"],"NC-13":[147897,137662,93,null],"NJ-2":[89715,78768,63,null],"NJ-5":[122179,60375,71,"W"],"NY-21":[41166,30011,24,null],"PA-7":[107238,72827,57,"W"],"SC-1":[129623,120566,75,null],"TN-5":[39126,21308,30,null],"TX-15":[14888,16750,17,null],"TX-28":[56145,23627,48,null],"TX-34":[93088,63731,82,null],"TX-35":[83403,43948,48,null],"WA-3":[0,0,0,null],"WI-1":[68223,67717,45,null],"WI-3":[62470,47530,33,null]},"meta":{"updated":"2026-11-04T02:52:26+00:00","source":"Decision Desk HQ public feed, read by the lab's loop (GitHub Actions) every 5 minutes","races":436,"withVotes":322,"called":221,"counties":2133},"ca":null,"merced":null,"answers":[{"id":"a1793725857997","q":"What is the current breakdown of seats in the house and senate","a":"Going into tonight Republicans hold the House 218 to 214, with one independent and two vacant seats; 218 is a majority, so Democrats need a net gain of only a few seats. Republicans hold the Senate 53 to 47 (45 Democrats plus 2 independents who vote with them), and Vice President Vance breaks ties. All 435 House seats and 35 Senate seats are on the ballot tonight; Republicans are defending 22 of those Senate seats, Democrats 13.","chart":{"bars":[{"label":"House Republicans","party":"R","value":218},{"label":"House Democrats","party":"D","value":214},{"label":"House independent / vacant","party":"none","value":3},{"label":"Senate Republicans","party":"R","value":53},{"label":"Senate Democrats + 2 independents","party":"D","value":47}],"title":"Seats held going into Nov 3, 2026","unit":""},"at":"2026-11-03T17:10:57.997Z","updated":"2026-11-03T17:15:00Z","by":"lab","keep":false,"src":[{"t":"Congress Countdown: party breakdown (Nov 2, 2026)","u":"https://www.congresscountdown.com/info/party-breakdown"},{"t":"Ballotpedia: U.S. Congress elections, 2026","u":"https://ballotpedia.org/United_States_Congress_elections,_2026"}]},{"id":"lab-midterm-penalty-since-1946","q":"How many House seats does the president's party usually lose in a midterm? (the long view)","a":"Since 1946 the president's party has lost House seats in 18 of 20 midterms, about 26 seats on average. The only gains were 1998 under Clinton (+4) and 2002 under George W. Bush (+8). The biggest losses were 2010 under Obama (-63), 1946 under Truman (-56) and 1994 under Clinton (-54); 2022 under Biden was a small one at -9.","chart":{"bars":[{"label":"1946 Truman","party":"D","value":-56},{"label":"1950 Truman","party":"D","value":-28},{"label":"1954 Eisenhower","party":"R","value":-18},{"label":"1958 Eisenhower","party":"R","value":-48},{"label":"1962 Kennedy","party":"D","value":-4},{"label":"1966 Johnson","party":"D","value":-47},{"label":"1970 Nixon","party":"R","value":-12},{"label":"1974 Ford","party":"R","value":-48},{"label":"1978 Carter","party":"D","value":-15},{"label":"1982 Reagan","party":"R","value":-26},{"label":"1986 Reagan","party":"R","value":-5},{"label":"1990 G.H.W. Bush","party":"R","value":-8},{"label":"1994 Clinton","party":"D","value":-54},{"label":"1998 Clinton","party":"D","value":4},{"label":"2002 G.W. Bush","party":"R","value":8},{"label":"2006 G.W. Bush","party":"R","value":-30},{"label":"2010 Obama","party":"D","value":-63},{"label":"2014 Obama","party":"D","value":-13},{"label":"2018 Trump","party":"R","value":-41},{"label":"2022 Biden","party":"D","value":-9}],"title":"House seats gained or lost by the president's party, every midterm since 1946","unit":""},"at":"2026-11-03T17:10:00Z","updated":"2026-11-03T22:40:00Z","by":"lab","keep":false,"src":[{"t":"American Presidency Project (UC Santa Barbara): seats gained/lost by the president's party in midterm elections, all 20 midterms 1946-2022","u":"https://www.presidency.ucsb.edu/node/332343/"}]},{"id":"a1793725016412","q":"Show me a graph of how much the presidents party typically suffers in the midterms.","a":"The president's party lost ground in both recent midterms. The Republicans lost about 4.8 points of the two-party House vote from 2016 to 2018 under Trump, and the Democrats lost about 2.8 points from 2020 to 2022 under Biden. These figures come from the national House vote in our data, which only goes back to 2016, so the chart shows two midterms and not a long-run average. No results are in yet tonight, so nothing from 2026 is on the chart. When the count starts, the early numbers will be partial, and big blue counties often count more slowly.","chart":{"bars":[{"label":"2016\u21922018 (Trump's GOP)","party":"R","value":-4.8},{"label":"2020\u21922022 (Biden's Democrats)","party":"D","value":-2.8}],"title":"President's party: change in House two-party vote, presidential year to next midterm (points)","unit":" pts"},"at":"2026-11-03T16:56:56.411Z","updated":"2026-11-03T16:56:56.411Z","by":"dashboard","keep":false,"src":null},{"id":"lab-house-turnout-5-cycles","q":"How has nationwide turnout in House races changed over the last five elections?","a":"House races drew about 128 million votes in 2016, 113 million in 2018, 153 million in 2020, 107 million in 2022 and 148 million in 2024. Midterms run well below presidential years: 2018, the highest-turnout midterm in about a century, still came in 15 million votes under 2016, and 2022 drew about 41 million fewer House votes than 2024. The question tonight is whether 2026 lands closer to 2018 or to 2022.","chart":{"bars":[{"label":"2016 (presidential)","party":"none","value":128.1},{"label":"2018 (midterm)","party":"none","value":112.8},{"label":"2020 (presidential)","party":"none","value":152.8},{"label":"2022 (midterm)","party":"none","value":107},{"label":"2024 (presidential)","party":"none","value":147.9}],"title":"Votes cast in all U.S. House races (millions)","unit":"M"},"at":"2026-11-03T16:55:00Z","updated":"2026-11-03T16:55:00Z","by":"lab","keep":false,"src":[{"t":"FiveThirtyEight election-results archive, House general elections (totals run about 1% under the House Clerk's because a few unopposed seats print no votes)","u":"https://github.com/fivethirtyeight/election-results"}]}],"copied":"2026-11-04T02:53:35.484843+00:00"}